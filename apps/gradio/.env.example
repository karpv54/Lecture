# Private: copy this to .env beside app.py. Never upload .env.
DUST_API_KEY=
GRADIUM_API_KEY=

# A workspace key usually cannot disclose its workspace ID.
# Copy this non-secret ID from your Dust URL: https://dust.tt/w/ID/...
DUST_WORKSPACE_ID=
# Existing Dust workspace member who will own/edit newly created tutor agents.
DUST_EDITOR_EMAIL=
# Match your account's Dust region: https://dust.tt, https://eu.dust.tt or https://us.dust.tt
DUST_BASE_URL=https://dust.tt

# Setup verifies and chooses Gaspard (French male) automatically. Optional override:
GRADIUM_VOICE_ID=
GRADIUM_BASE_URL=https://eu.api.gradium.ai/api/

# Optional: setup discovers a model already available in your Dust workspace.
DUST_MODEL_PROVIDER=
DUST_MODEL_ID=
GRADIO_SERVER_PORT=7865
# Optional absolute private data directory. Default: repository/data (ignored).
# TUTOR_DATA_DIR=
